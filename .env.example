DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_S=180
DEEPSEEK_MAX_RETRIES=4
DEEPSEEK_RETRY_BACKOFF_S=1.5

TAVILY_API_KEY=

# SkillHub / moltbot-summarize
SKILLHUB_API_KEY=
MOLTBOT_SUMMARIZE_ENDPOINT=https://www.skillhub.club/api/skills/moltbot-moltbot-summarize

# summarize.sh CLI skill (skills/SKILL.md)
SUMMARIZE_MODEL=
SUMMARIZE_LENGTH=short

# Pipeline knobs
RESEARCH_QUERY=cat:cs.CL OR cat:cs.LG OR "large language model" OR "LLM" OR "NLP"
ARXIV_MAX_RESULTS=25
YOUTUBE_MAX_RESULTS=10
BILIBILI_MAX_RESULTS=10

# Arxiv networking (optional)
ARXIV_API_URL=https://export.arxiv.org/api/query
ARXIV_HTTP_TIMEOUT_S=30
ARXIV_HTTP_RETRIES=3
ARXIV_HTTP_BACKOFF=0.7

# When official Arxiv API returns nothing (e.g. DNS), use Tavily on arxiv.org
ARXIV_FALLBACK=TAVILY
# Optional: override Tavily query; default strips cat:... from RESEARCH_QUERY
ARXIV_TAVILY_QUERY=
ARXIV_TAVILY_DOMAINS=arxiv.org

# Chroma / RAG
MEMORY_PERSIST_DIR=memory/store
MEMORY_COLLECTION=research_items
MEMORY_BACKEND=auto
EMBEDDING_MODEL=hash-1024
RAG_TOP_K=6

# Scheduler
SCHEDULE_INTERVAL_DAYS=3
STATE_DIR=.state
EMAIL_DEDUP=true

# Email (optional)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_USE_SSL=true
EMAIL_FROM=
EMAIL_TO=
EMAIL_SUBJECT=AI Research Report (last 3 days)

